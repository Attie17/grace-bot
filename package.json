{
  "name": "stabilis-bot",
  "type": "module",
  "version": "1.1.0",
  "description": "Grace: Conversational AI intake bot for Stabilis Treatment Centre",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
