    "express": "^4.18.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "pino": "^8.17.0",
    "pino-http": "^9.0.0",
    "pino-pretty": "^13.1.3",
    "twilio": "^4.10.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
