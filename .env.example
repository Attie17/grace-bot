# === WhatsApp Business API (Meta Cloud API — active) ===
# Get from: https://developers.facebook.com → Your App → WhatsApp → API Setup
META_WHATSAPP_PHONE_NUMBER_ID=     # Phone Numbers > Phone Number ID (15-digit number)
META_WHATSAPP_ACCESS_TOKEN=        # System User permanent token (Accounts Center > System Users)
META_WHATSAPP_APP_SECRET=          # App Settings > Basic > App Secret (for webhook HMAC verification)
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=# Arbitrary string you choose; paste the same value in Meta Dashboard > Webhook config

# Optional: set to 'twilio' to force rollback to the dormant Twilio path
# WHATSAPP_PROVIDER=meta

# === WhatsApp Business API (Twilio — DORMANT, kept for rollback) ===
# Set WHATSAPP_PROVIDER=twilio to reactivate without code changes.
# TWILIO_ACCOUNT_SID=ACxxxxx
# TWILIO_AUTH_TOKEN=xxxxx
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# === Therapist Alerts ===
